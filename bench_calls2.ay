fn transforma(x) {
    if x % 2 == 0 {
        return (x / 2) + 3
    }
    return (x * 3) + 1
}

fn main() {
    var limite = 50000000
    var inicio = time()
    var estado = 123456
    var i = 0

    while i < limite {
        estado = transforma(estado + i)
        i = i + 1
    }

    var fim = time()
    print("Estado Final:")
    print(estado)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
