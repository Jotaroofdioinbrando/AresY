fn calcular(x) {
    var a = (x * 7) ^ (x / 8)
    return (a * 13) + (x % 256)
}

fn main() {
    var limite = 100000000
    var inicio = time()
    var soma = 0
    var i = 0

    while i < limite {
        soma = soma + calcular(i)
        i = i + 1
    }

    var fim = time()

    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)

    return 0
}
