fn main() {
    var tam = 15000
    var arr = array(tam)
    var i = 0
    
    // Preenche array de forma decrescente (pior caso)
    while i < tam {
        arr[i] = tam - i
        i = i + 1
    }

    var inicio = time()

    // Bubble Sort
    i = 0
    var j = 0
    var temp = 0
    var limite_j = 0

    while i < tam {
        j = 0
        limite_j = tam - i - 1
        while j < limite_j {
            if arr[j] > arr[j + 1] {
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }

    var fim = time()

    print("Primeiro elemento:")
    print(arr[0])
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
