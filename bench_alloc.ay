fn main() {
    var limite = 1000000
    var inicio = time()

    // Aloca 1 milhão de sub-arrays/objetos dinamicos na Heap
    var objetos = array(limite)
    var i = 0

    while i < limite {
        // Aloca um mini-bloco de memória para cada item
        var obj = array(2)
        obj[0] = i
        obj[1] = i * 2
        objetos[i] = obj
        i = i + 1
    }

    // Leitura e Varredura
    var soma = 0
    i = 0
    while i < limite {
        var o = objetos[i]
        soma = soma + o[0] + o[1]
        i = i + 1
    }

    var fim = time()
    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
