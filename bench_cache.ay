fn main() {
    var tam = 10000000
    var arr = array(tam)
    var i = 0

    // Preenche o array com um padrão de saltos
    while i < tam {
        arr[i] = (i * 7 + 13) % tam
        i = i + 1
    }

    var inicio = time()

    // Percorre pulando de elemento em elemento dependendo do valor lido
    var idx = 0
    var soma = 0
    var passadas = 0
    var limite_passadas = 20000000

    while passadas < limite_passadas {
        idx = arr[idx]
        soma = soma + idx
        passadas = passadas + 1
    }

    var fim = time()
    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
