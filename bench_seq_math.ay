fn calcular(x) {
    var a = x * 1.371
    var b = a * a
    var c = b + (x * 0.731)
    return (c * 0.917) - (a * 0.213) + 7.31
}

fn main() {
    var tamanho = 10000000
    var inicio = time()

    var arr = array(tamanho)
    var i = 0

    while i < tamanho {
        arr[i] = i
        i = i + 1
    }

    var soma = 0.0
    i = 0

    while i < tamanho {
        var x = arr[i]
        soma = soma + calcular(x)
        i = i + 1
    }

    var fim = time()

    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)

    return 0
}
