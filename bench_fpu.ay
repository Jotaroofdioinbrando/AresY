fn main() {
    var limite = 20000000
    var inicio = time()
    var soma = 0.0
    var x = 0.5
    var i = 0

    while i < limite {
        // Polinômio de Ponto Flutuante
        soma = soma + (x * x * x * x) - (3.5 * x * x) + (2.1 * x) - 0.7
        x = x + 0.0000001
        i = i + 1
    }

    var fim = time()
    print("Soma FPU:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
