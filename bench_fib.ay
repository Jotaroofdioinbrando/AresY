fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    var inicio = time()

    var i = 0
    while i < 10 {
        print(fib(30))
        i = i + 1
    }

    var fim = time()

    print("tempo:")
    print(fim - inicio)

    return 0
}
