fn normalizar(nome: str) -> str {
    return upper(nome)
}

fn main() {
    var nomes = array(4)

    nomes[0] = 10
    nomes[1] = 20
    nomes[2] = 30
    nomes[3] = 40

    print("=== MINI AGENDA ===")

    var nome = "joao"
    var nome2 = normalizar(nome)

    print("Nome:")
    print(nome)

    print("Nome normalizado:")
    print(nome2)

    print("Dados:")
    var i = 0

    while i < 4 {
        print(nomes[i])
        i = i + 1
    }

    return 0
}
