fn contar(s: str) -> i64 {
    return len(s)
}

fn transformar(s: str) -> str {
    return upper(s)
}

fn main() {
    var conteudo = read_file("dados.txt")

    print("=== MINI TOOL AresY ===")
    print("Caracteres:")
    print(contar(conteudo))

    print("Texto em maiúsculo:")
    print(transformar(conteudo))

    var i = 0
    var total = 0

    while i < len(conteudo) {
        var c = char_at(conteudo, i)

        if c == "\n" {
            total = total + 1
        }

        i = i + 1
    }

    print("Quebras de linha:")
    print(total)

    return 0
}
