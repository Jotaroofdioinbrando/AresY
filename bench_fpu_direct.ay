fn main() {
    var limite = 10000000
    var inicio = time()
    var soma = 0.0
    var i = 0

    while i < limite {
        var x = i
        var a = x * 1.371
        var b = a * a
        var c = b + x * 0.72
        soma = soma + c * 0.92 - a * 0.213 + 7.31
        i = i + 1
    }

    var fim = time()
    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
