fn main() {
    var limite = 100000000
    var inicio = time()
    var acc = 0
    var i = 0

    while i < limite {
        if i % 2 == 0 {
            acc = acc + i * 2
        } else {
            acc = acc - i
        }
        i = i + 1
    }

    var fim = time()
    print("Resultado:")
    print(acc)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
