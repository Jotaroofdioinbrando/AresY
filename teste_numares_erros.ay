import "stdlib/numares.ay"

fn main() {
    print("Iniciando testes de erro da biblioteca numares...")

    // 1. Teste arange com step == 0
    try {
        var r = arange(0, 10, 0)
        print("ERRO: arange com step 0 deveria ter falhado")
    } catch e1 {
        print("Sucesso (erro capturado): " + e1)
    }

    // 2. Teste amin com array vazio
    try {
        var vazio = zeros(0)
        var m = amin(vazio)
        print("ERRO: amin com array vazio deveria ter falhado")
    } catch e2 {
        print("Sucesso (erro capturado): " + e2)
    }

    // 3. Teste amax com array vazio
    try {
        var vazio = zeros(0)
        var m = amax(vazio)
        print("ERRO: amax com array vazio deveria ter falhado")
    } catch e3 {
        print("Sucesso (erro capturado): " + e3)
    }

    // 4. Teste add com tamanhos diferentes
    try {
        var a1 = zeros(3)
        var a2 = zeros(4)
        var r = add(a1, a2)
        print("ERRO: add com tamanhos diferentes deveria ter falhado")
    } catch e4 {
        print("Sucesso (erro capturado): " + e4)
    }

    // 5. Teste sub com tamanhos diferentes
    try {
        var a1 = zeros(3)
        var a2 = zeros(4)
        var r = sub(a1, a2)
        print("ERRO: sub com tamanhos diferentes deveria ter falhado")
    } catch e5 {
        print("Sucesso (erro capturado): " + e5)
    }

    // 6. Teste mul com tamanhos diferentes
    try {
        var a1 = zeros(3)
        var a2 = zeros(4)
        var r = mul(a1, a2)
        print("ERRO: mul com tamanhos diferentes deveria ter falhado")
    } catch e6 {
        print("Sucesso (erro capturado): " + e6)
    }

    // 7. Teste div com tamanhos diferentes
    try {
        var a1 = zeros(3)
        var a2 = zeros(4)
        var r = div(a1, a2)
        print("ERRO: div com tamanhos diferentes deveria ter falhado")
    } catch e7 {
        print("Sucesso (erro capturado): " + e7)
    }

    // 8. Teste div com divisao por zero
    try {
        var a1 = ones(3)
        var a2 = zeros(3)
        var r = div(a1, a2)
        print("ERRO: div com divisao por zero deveria ter falhado")
    } catch e8 {
        print("Sucesso (erro capturado): " + e8)
    }

    // 9. Teste dot com tamanhos diferentes
    try {
        var a1 = zeros(3)
        var a2 = zeros(4)
        var r = dot(a1, a2)
        print("ERRO: dot com tamanhos diferentes deveria ter falhado")
    } catch e9 {
        print("Sucesso (erro capturado): " + e9)
    }

    print("Todos os testes de erro passaram com sucesso!")
}
