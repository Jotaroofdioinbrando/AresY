fn main() {
    var limite = 200000000
    var inicio = time()
    var a = 123456789
    var i = 0

    while i < limite {
        a = (a ^ i) + (i % 7)
        i = i + 1
    }

    var fim = time()
    print("Resultado:")
    print(a)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
