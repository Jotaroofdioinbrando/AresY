fn transformar(s: str) -> str {
    var x = upper(s)
    return x
}

fn main() {
    var nome = "AresY"
    var frase = "aresy is fast and simple"

    print("=== STRING TEST ===")

    print(nome)
    print(upper(nome))
    print(lower(nome))

    print(frase)
    print(upper(frase))

    print("Length:")
    print(len(frase))

    print("Substring:")
    print(substr(frase, 0, 5))

    print("Char:")
    print(char_at(frase, 0))

    print("Function:")
    print(transformar("hello aresy"))

    return 0
}
