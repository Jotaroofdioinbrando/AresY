fn soma_array(arr, n) {
    var soma = 0
    var i = 0

    while i < n {
        soma = soma + arr[i]
        i = i + 1
    }

    return soma
}

fn main() {
    var arr = array(10)

    var i = 0
    while i < 10 {
        arr[i] = i * i
        i = i + 1
    }

    print(soma_array(arr, 10))
    return 0
}
