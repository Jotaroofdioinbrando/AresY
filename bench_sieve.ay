fn main() {
    var limite = 10000000
    var inicio = time()

    // 0 = primo, 1 = não primo
    var e_composto = array(limite)
    var primos = 0
    var i = 2

    while i < limite {
        if e_composto[i] == 0 {
            primos = primos + 1
            var j = i * 2
            while j < limite {
                e_composto[j] = 1
                j = j + i
            }
        }
        i = i + 1
    }

    var fim = time()
    print("Total de Primos:")
    print(primos)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
