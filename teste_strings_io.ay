fn main() {
    print("=== TESTE DE STRINGS E I/O ===")

    // 1. Teste de Funções de String
    var texto = "Linguagem AresY v8"
    print("Texto original: " + texto)
    print("Tamanho (len):")
    print(len(texto))

    var maiusculo = upper(texto)
    print("Upper: " + maiusculo)

    var minusculo = lower(texto)
    print("Lower: " + minusculo)

    var fatia = substr(texto, 10, 5)
    print("Substr (10, 5): " + fatia)

    print("Char_at (index 0): " + char_at(texto, 0))

    // 2. Teste de Comparação de Strings
    var s1 = "AresY"
    var s2 = "AresY"
    var s3 = "Python"

    if s1 == s2 {
        print("Comparação == funcionando: s1 e s2 sao iguais!")
    }

    if s1 != s3 {
        print("Comparação != funcionando: s1 e s3 sao diferentes!")
    }

    // 3. Conversão de Tipos
    var num = 2026
    var texto_num = "Ano: " + str(num)
    print("Conversão str(): " + texto_num)

    // 4. Teste de I/O de Arquivos (Write, Append, Read)
    print("\n--- Testando Arquivos ---")
    var arquivo = "teste_aresy.txt"

    write_file(arquivo, "Linha 1: AresY e muito rapido!\n")
    append_file(arquivo, "Linha 2: Testando append_file.\n")

    var conteudo = read_file(arquivo)
    print("Conteúdo lido do arquivo:")
    print(conteudo)

    return 0
}
