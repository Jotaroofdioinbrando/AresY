fn adicionar(a, b) {
    return a + b
}

fn main() {
    var limite = 100000000
    var inicio = time()
    var soma = 0
    var i = 0

    while i < limite {
        soma = soma + adicionar(i, 3)
        i = i + 1
    }

    var fim = time()

    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)

    return 0
}
