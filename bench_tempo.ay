fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    var inicio = time()

    var i = 0
    var resultado = 0

    while i < 10 {
        resultado = fib(30)
        i = i + 1
    }

    var fim = time()

    print("Resultado:")
    print(resultado)
    print("Tempo:")
    print(fim - inicio)

    return 0
}
