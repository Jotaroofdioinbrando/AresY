fn main() {
    var tamanho = 10000000
    var inicio = time()

    var arr = array(tamanho)
    var i = 0

    while i < tamanho {
        arr[i] = (i * 7919 + 12345) % tamanho
        i = i + 1
    }

    var idx = 0
    var soma = 0
    var passadas = 0
    var limite = 20000000

    while passadas < limite {
        idx = arr[idx]
        soma = soma + idx
        passadas = passadas + 1
    }

    var fim = time()

    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)

    return 0
}
