import "m"
extern fn cbrt(f64) -> f64

fn soma(a, b) {
    return a + b
}

fn media(a: double, b: double) -> double {
    return (a + b) / 2.0
}

fn saudacao(nome: str) -> str {
    return "Ola, " + nome
}

fn aplicar(func, x, y) {
    return func(x, y)
}

fn divide(a, b) {
    if b == 0 {
        throw "divisao por zero"
    }
    return a / b
}

fn main() {
    print("=== VARIAVEIS E TIPOS ===")
    var inteiro = 42
    var decimal = 3.14
    var texto = "AresY"
    var verdadeiro = true
    var falso = false

    print(inteiro)
    print(decimal)
    print(texto)
    print(verdadeiro)
    print(falso)

    inteiro = inteiro + 8
    print(inteiro)

    print("=== ARITMETICA ===")
    print(10 + 3)
    print(10 - 3)
    print(10 * 3)
    print(10 / 3)
    print(10 % 3)
    print(-42)

    print("=== COMPARACAO ===")
    print(10 == 10)
    print(10 != 5)
    print(10 < 20)
    print(10 > 5)
    print(10 <= 10)
    print(10 >= 10)

    print("=== BITWISE ===")
    print(6 & 3)
    print(6 | 3)
    print(6 ^ 3)

    print("=== FUNCOES ===")
    print(soma(20, 22))
    print(media(10.0, 20.0))
    print(saudacao("AresY"))

    print("=== STRINGS ===")
    var s = "AresY e rapido"

    print(s)
    print(len(s))
    print(upper(s))
    print(lower(s))
    print(substr(s, 0, 5))
    print(char_at(s, 1))
    print(str(12345))
    print("Ola, " + "AresY")
    print("abc" == "abc")
    print("abc" != "xyz")

    print("=== ARRAY ===")
    var arr = array(5)
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    arr[3] = 40
    arr[4] = 50

    print(arr[0])
    print(arr[2])
    print(arr[4])

    var soma_array = 0
    var i = 0

    while i < 5 {
        soma_array = soma_array + arr[i]
        i = i + 1
    }

    print(soma_array)

    print("=== IF / ELSE / WHILE ===")
    var contador = 0

    while contador < 3 {
        if contador == 1 {
            print("meio")
        } else {
            print(contador)
        }

        contador = contador + 1
    }

    print("=== MATEMATICA ===")
    print(sqrt(16.0))
    print(sin(0.0))
    print(cos(0.0))
    print(tan(0.0))
    print(atan(1.0))
    print(atan2(1.0, 1.0))
    print(log(1.0))
    print(log10(100.0))
    print(exp(1.0))
    print(pow(2.0, 10.0))
    print(floor(3.9))
    print(ceil(3.1))
    print(abs(-42))
    print(min(10, 20))
    print(max(10, 20))
    print(pi())

    print("=== EXTERN C ===")
    print(cbrt(27.0))

    print("=== CALLBACK ===")
    print(aplicar(soma, 20, 22))

    print("=== EXCECAO ===")
    try {
        var resultado = divide(10, 2)
        print(resultado)
    } catch erro_normal {
        print("ERRO: " + erro_normal)
    }

    try {
        var resultado_erro = divide(10, 0)
        print(resultado_erro)
    } catch erro_divisao {
        print("ERRO CAPTURADO: " + erro_divisao)
    }

    print("=== ALEATORIO ===")
    var aleatorio = random(100)
    print(aleatorio)

    print("=== TEMPO ===")
    var inicio = time()
    sleep(0.1)
    var fim = time()
    print(fim - inicio)

    print("=== ARQUIVOS ===")
    print(write_file("teste_tudo.txt", "AresY\n"))
    print(append_file("teste_tudo.txt", "funciona\n"))
    print(read_file("teste_tudo.txt"))

    print("=== FIM ===")

    return 0
}
