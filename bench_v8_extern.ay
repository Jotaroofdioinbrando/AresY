import "m"
extern fn cbrt(f64) -> f64

fn main() {
    var limite = 10000000
    var inicio = time()
    var soma = 0.0
    var i = 1.0

    while i < limite {
        soma = soma + cbrt(i)
        i = i + 1.0
    }

    var fim = time()
    print("Soma de 10M de Raízes Cúbicas (C extern cbrt):")
    print(soma)
    print("Tempo AresY v8 (Extern C):")
    print(fim - inicio)
    return 0
}
