fn somar(a, b) {
    return a + b
}

fn multiplicar(a, b) {
    return a * b
}

fn executar_operacao(func, x, y) {
    return func(x, y)
}

fn main() {
    var limite = 30000000
    var inicio = time()
    var acc = 0
    var i = 0

    while i < limite {
        acc = executar_operacao(somar, acc, 1)
        acc = executar_operacao(multiplicar, acc, 1)
        i = i + 1
    }

    var fim = time()
    print("Resultado Callback:")
    print(acc)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
