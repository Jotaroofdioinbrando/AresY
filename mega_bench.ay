fn trabalho(n: i64) -> i64 {
    var a = 1
    var b = 1
    var total = 0
    var i = 0

    while i < n {
        var c = (a + b) % 1000000007
        a = b
        b = c

        var x = (a * 31 + b * 17 + i * 13) % 1000000007

        if x % 2 == 0 {
            total = total + x * 3
        } else {
            total = total + x * 7
        }

        total = total % 1000000007

        var s = "AresY-" + str(i % 1000)
        total = total + len(s)

        i = i + 1
    }

    return total
}

fn main() {
    var inicio = time()

    var resultado = trabalho(20000000)

    var fim = time()

    print("=== AresY ===")
    print("Resultado:")
    print(resultado)
    print("Tempo:")
    print(fim - inicio)

    return 0
}
