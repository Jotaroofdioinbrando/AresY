fn main() {
    var limite = 10000
    var inicio = time()
    var texto = ""
    var i = 0

    while i < limite {
        texto = texto + "A"
        i = i + 1
    }

    var fim = time()
    print("Sucesso! Concatenação de Strings Funcionou!")
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
