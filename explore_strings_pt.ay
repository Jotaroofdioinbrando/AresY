fn transformar(s: str) -> str {
    return upper(s)
}

fn main() {
    var nome = "AresY"
    var frase = "aresy e simples e rapido"

    print("=== TESTE DE STRINGS ===")

    print("Nome:")
    print(nome)

    print("Maiusculo:")
    print(upper(nome))

    print("Minusculo:")
    print(lower(nome))

    print("Frase:")
    print(frase)

    print("Tamanho:")
    print(len(frase))

    print("Parte da frase:")
    print(substr(frase, 0, 5))

    print("Primeiro caractere:")
    print(char_at(frase, 0))

    print("Funcao:")
    print(transformar("linguagem aresy"))

    return 0
}
