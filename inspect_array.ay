fn main() {
    var tamanho = 1000000
    var inicio = time()

    var arr = array(tamanho)

    var i = 0
    while i < tamanho {
        arr[i] = i * 3 + 7
        i = i + 1
    }

    var soma = 0
    i = 0

    while i < tamanho {
        soma = soma + arr[i]
        i = i + 1
    }

    var fim = time()

    print("Soma:")
    print(soma)
    print("Tempo:")
    print(fim - inicio)

    return 0
}
