fn main() {
    var limite = 10000000
    var arr = array(limite)
    
    // Preenche o array
    var i = 0
    while i < limite {
        arr[i] = i
        i = i + 1
    }

    var inicio = time()
    
    // Inverte o array in-place
    var esquerda = 0
    var direita = limite - 1
    while esquerda < direita {
        var temp = arr[esquerda]
        arr[esquerda] = arr[direita]
        arr[direita] = temp
        esquerda = esquerda + 1
        direita = direita - 1
    }

    var fim = time()
    print("Array Invertido! Elemento 0:")
    print(arr[0])
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
