fn main() {
    var tamanho = 10000000
    var inicio = time()
    
    var arr = array(tamanho)
    var i = 0
    while i < tamanho {
        arr[i] = i * 2
        i = i + 1
    }
    
    var soma = 0
    i = 0
    while i < tamanho {
        soma = soma + arr[i]
        i = i + 1
    }
    
    var fim = time()
    print("Soma:")
    print(soma)
    print("Tempo AresY:")
    print(fim - inicio)
    return 0
}
