fn calcular(n: i64) -> i64 {
    var dados = array(100)
    var i = 0
    var total = 0

    while i < 100 {
        dados[i] = (i + 1) * 37
        i = i + 1
    }

    i = 0

    while i < n {
        var pos = i % 100
        total = total + dados[pos] * (i + 1)

        if total > 1000000007 {
            total = total % 1000000007
        }

        i = i + 1
    }

    return total
}

fn main() {
    var inicio = time()

    var resultado = 0
    var i = 0

    while i < 1000 {
        resultado = calcular(100000)
        i = i + 1
    }

    var fim = time()

    print("Resultado:")
    print(resultado)
    print("Tempo:")
    print(fim - inicio)

    return 0
}
