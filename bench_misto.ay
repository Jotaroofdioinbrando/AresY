fn calcular(n: i64) -> i64 {
    var total = 0
    var i = 1

    while i <= n {
        var x = i * 37
        x = x % 1000000007

        if x % 2 == 0 {
            total = total + x * 3
        } else {
            total = total + x * 7
        }

        total = total % 1000000007
        i = i + 1
    }

    return total
}

fn main() {
    var inicio = time()
    var resultado = 0
    var i = 0

    while i < 1000 {
        resultado = calcular(100000)
        i = i + 1
    }

    var fim = time()

    print("Resultado:")
    print(resultado)
    print("Tempo:")
    print(fim - inicio)

    return 0
}
